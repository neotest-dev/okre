---
import { formatPrice, type MenuCategory } from "../data/menu";

interface Props {
  category: MenuCategory;
}

const { category } = Astro.props;
---

<section id={category.id} class="mb-6">
  <header class="mb-3 border-b border-stone-800/70 pb-2">
    <h2 class="font-display text-3xl font-semibold uppercase tracking-wide">{category.title}</h2>
    {category.subtitle && <p class="text-sm text-stone-800">{category.subtitle}</p>}
  </header>

  {
    category.columns && (
      <div class="flex justify-end gap-6 pr-1 text-xs font-semibold uppercase text-stone-800">
        {category.columns.map((c) => (
          <span class="w-14 text-right">{c}</span>
        ))}
      </div>
    )
  }

  <ul class="divide-y divide-stone-800/15">
    {
      category.items.map((item) => (
        <li class="py-3">
          <div class="flex items-baseline gap-2">
            <h3 class="font-semibold uppercase leading-snug">{item.name}</h3>
            <span class="mb-1 flex-1 border-b border-dashed border-stone-800/50" aria-hidden="true" />
            {item.price !== undefined && (
              <span class="font-bold tabular-nums">{formatPrice(item.price)}</span>
            )}
            {item.variants && !category.columns && (
              <span class="flex flex-col text-right font-bold tabular-nums">
                {item.variants.map((x) => (
                  <span>
                    <span class="mr-2 text-xs font-normal">{x.label}</span>
                    {formatPrice(x.price)}
                  </span>
                ))}
              </span>
            )}
            {item.variants && category.columns && (
              <span class="flex gap-6 font-bold tabular-nums">
                {item.variants.map((x) => (
                  <span class="w-14 text-right">{formatPrice(x.price)}</span>
                ))}
              </span>
            )}
          </div>
          {item.description && (
            <p class="mt-0.5 max-w-[85%] text-xs leading-snug text-stone-800">{item.description}</p>
          )}
        </li>
      ))
    }
  </ul>
</section>

