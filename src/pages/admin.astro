---
import Layout from "../layouts/Layout.astro";
import data from "../data/menu.json";
// El panel solo existe en tu PC. En Vercel (producción) redirige al inicio.
if (import.meta.env.PROD) return Astro.redirect("/");
---

<Layout>
  <div class="min-h-dvh bg-stone-100 text-stone-900">
    <!-- LOGIN -->
    <div id="login" class="grid min-h-dvh place-items-center p-4">
      <form id="login-form" class="w-full max-w-sm space-y-4 rounded-2xl bg-white p-6 shadow-xl">
        <h1 class="font-display text-2xl font-semibold text-[#873620]">Panel Okre</h1>
        <input id="pass" type="password" placeholder="Contraseña" autocomplete="current-password"
          class="w-full rounded-xl border border-stone-300 px-4 py-3 text-base outline-none focus:border-[#873620] focus:ring-2 focus:ring-[#873620]/30" />
        <p id="login-err" class="hidden text-sm font-medium text-red-600">Contraseña incorrecta</p>
        <button class="w-full rounded-xl bg-[#873620] py-3 font-semibold text-white active:scale-95">Entrar</button>
      </form>
    </div>

    <!-- PANEL -->
    <div id="panel" class="hidden">
      <header class="sticky top-0 z-10 flex items-center gap-3 bg-[#873620] px-4 py-3 text-white shadow-md">
        <h1 class="flex-1 font-display text-xl font-semibold">Editar menú</h1>
        <span id="msg" class="text-sm font-semibold"></span>
        <button id="guardar" class="rounded-lg bg-white px-4 py-2 font-bold text-[#873620] active:scale-95">💾 Guardar</button>
      </header>

      <main class="mx-auto max-w-3xl space-y-4 p-4 pb-24">
        <p class="rounded-xl bg-amber-100 p-3 text-sm text-amber-900">
          Cambia lo que quieras → pulsa <b>Guardar</b> → para publicar en Vercel:
          <code class="rounded bg-white px-1.5 py-0.5">git add . && git commit -m "menu" && git push</code>
        </p>
        <div id="app" class="space-y-4"></div>
        <button id="nueva" class="w-full rounded-xl bg-[#873620] py-3 font-semibold text-white active:scale-95">+ Nueva categoría</button>
      </main>
    </div>
  </div>
</Layout>

<script define:vars={{ inicial: data }}>
  const HASH = "db14dff34ca1d99987f9da7ae01d7e79fb5a0bc880767a9f86825f5c1bc8f74d";
  const sha = async (s) =>
    [...new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(s)))]
      .map((b) => b.toString(16).padStart(2, "0")).join("");

  const loginEl = document.getElementById("login");
  const panelEl = document.getElementById("panel");
  const entrar = () => { loginEl.classList.add("hidden"); panelEl.classList.remove("hidden"); };
  if (sessionStorage.getItem("okre-admin") === HASH) entrar();

  document.getElementById("login-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    if ((await sha(document.getElementById("pass").value)) === HASH) {
      sessionStorage.setItem("okre-admin", HASH);
      entrar();
    } else document.getElementById("login-err").classList.remove("hidden");
  });

  let menu = inicial;
  const app = document.getElementById("app");
  const msg = document.getElementById("msg");
  const h = (s) => String(s ?? "").replace(/&/g, "&amp;").replace(/"/g, "&quot;").replace(/</g, "&lt;");

  const INPUT = "rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm outline-none focus:border-[#873620] focus:ring-2 focus:ring-[#873620]/30";
  const BTN = "rounded-lg bg-stone-200 px-3 py-2 text-sm font-medium active:scale-95";
  const BTN_RED = "rounded-lg bg-red-600 px-3 py-2 text-sm font-medium text-white active:scale-95";
  const BTN_MAIN = "rounded-lg bg-[#873620] px-3 py-2 text-sm font-semibold text-white active:scale-95";

  function platoHTML(c, p, pi, ci) {
    const cols = c.columnas || [];
    let precios;
    if (cols.length) {
      const v = p.variantes || [];
      precios = cols.map((col, k) => `<label class="flex items-center gap-1 text-xs text-stone-600">${h(col)}
        <input class="${INPUT} w-20" type="number" step="0.5" data-f="var" data-k="${k}" value="${v[k]?.precio ?? ""}"></label>`).join("");
    } else if (p.variantes?.length) {
      precios = p.variantes.map((v, k) => `<span class="flex gap-1">
        <input class="${INPUT} w-16" placeholder="1/4" data-f="vet" data-k="${k}" value="${h(v.etiqueta)}">
        <input class="${INPUT} w-20" type="number" step="0.5" data-f="vpr" data-k="${k}" value="${v.precio}"></span>`).join("") +
        `<button class="${BTN}" data-a="vmas">+ precio</button><button class="${BTN}" data-a="vquitar">un solo precio</button>`;
    } else {
      precios = `<label class="flex items-center gap-1 text-sm text-stone-600">S/
        <input class="${INPUT} w-24" type="number" step="0.5" data-f="precio" value="${p.precio ?? ""}"></label>
        <button class="${BTN}" data-a="vmas">varios precios</button>`;
    }
    return `<div class="plato space-y-2 border-t border-stone-200 pt-3" data-p="${pi}">
      <div class="flex flex-wrap items-center gap-2">
        <input class="${INPUT} min-w-40 flex-1 font-semibold" placeholder="Nombre del plato" data-f="nombre" value="${h(p.nombre)}">
        ${precios}
        <button class="${BTN}" data-a="subir">↑</button><button class="${BTN}" data-a="bajar">↓</button>
        <button class="${BTN_RED}" data-a="delplato">✕</button>
      </div>
      <textarea rows="2" class="${INPUT} w-full" placeholder="Descripción (opcional)" data-f="descripcion">${h(p.descripcion)}</textarea>
    </div>`;
  }

  function render() {
    app.innerHTML = menu.map((c, ci) => `
      <section class="cat rounded-2xl bg-white p-4 shadow ${c.oculta ? "opacity-60 ring-2 ring-stone-300" : ""}" data-c="${ci}">
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <input class="${INPUT} min-w-40 flex-1 text-lg font-bold" placeholder="Nombre de la categoría" data-f="titulo" value="${h(c.titulo)}">
          <label class="flex items-center gap-1 text-sm">Página
            <input class="${INPUT} w-16" type="number" min="1" data-f="pagina" value="${c.pagina}"></label>
          <label class="flex items-center gap-1.5 text-sm"><input type="checkbox" class="size-4 accent-[#873620]" data-f="oculta" ${c.oculta ? "checked" : ""}> Oculta</label>
          <button class="${BTN}" data-a="csubir">↑</button><button class="${BTN}" data-a="cbajar">↓</button>
          <button class="${BTN_RED}" data-a="delcat">Borrar</button>
        </div>
        <div class="mb-3 flex flex-wrap gap-2">
          <input class="${INPUT} min-w-40 flex-1" placeholder="Subtítulo (opcional)" data-f="subtitulo" value="${h(c.subtitulo)}">
          <input class="${INPUT} min-w-40 flex-1" placeholder="Columnas de precio (ej: Vaso, 1 litro)" data-f="columnas" value="${h((c.columnas || []).join(", "))}">
        </div>
        <div class="space-y-3">${c.platos.map((p, pi) => platoHTML(c, p, pi, ci)).join("")}</div>
        <button class="${BTN_MAIN} mt-4" data-a="nuevoplato">+ Plato</button>
      </section>`).join("");
  }

  const mover = (arr, i, d) => { const j = i + d; if (j < 0 || j >= arr.length) return; [arr[i], arr[j]] = [arr[j], arr[i]]; };

  app.addEventListener("input", (e) => {
    const el = e.target, f = el.dataset.f; if (!f) return;
    const catEl = el.closest(".cat"), c = menu[catEl.dataset.c];
    const platoEl = el.closest(".plato");
    if (!platoEl) {
      if (f === "oculta") { c.oculta = el.checked; catEl.classList.toggle("opacity-60", el.checked); catEl.classList.toggle("ring-2", el.checked); catEl.classList.toggle("ring-stone-300", el.checked); }
      else if (f === "columnas") c.columnas = el.value.split(",").map((s) => s.trim()).filter(Boolean);
      else if (f === "pagina") c.pagina = Number(el.value) || 1;
      else c[f] = el.value;
      return;
    }
    const p = c.platos[platoEl.dataset.p], k = Number(el.dataset.k);
    if (f === "precio") p.precio = el.value === "" ? undefined : Number(el.value);
    else if (f === "var") {
      p.variantes = p.variantes || [];
      c.columnas.forEach((col, i) => (p.variantes[i] = p.variantes[i] || { etiqueta: col, precio: 0 }));
      p.variantes[k] = { etiqueta: c.columnas[k], precio: Number(el.value) || 0 };
    } else if (f === "vet") p.variantes[k].etiqueta = el.value;
    else if (f === "vpr") p.variantes[k].precio = Number(el.value) || 0;
    else p[f] = el.value;
  });

  app.addEventListener("change", (e) => { if (e.target.dataset.f === "columnas") render(); });

  app.addEventListener("click", (e) => {
    const a = e.target.dataset.a; if (!a) return;
    const catEl = e.target.closest(".cat"), ci = Number(catEl.dataset.c), c = menu[ci];
    const platoEl = e.target.closest(".plato"), pi = platoEl ? Number(platoEl.dataset.p) : -1;
    if (a === "nuevoplato") c.platos.push({ nombre: "", descripcion: "", precio: undefined });
    else if (a === "delplato") { if (confirm("¿Borrar este plato?")) c.platos.splice(pi, 1); else return; }
    else if (a === "subir") mover(c.platos, pi, -1);
    else if (a === "bajar") mover(c.platos, pi, 1);
    else if (a === "csubir") mover(menu, ci, -1);
    else if (a === "cbajar") mover(menu, ci, 1);
    else if (a === "delcat") { if (confirm("¿Borrar la categoría completa? (Mejor márcala como Oculta para guardarla)")) menu.splice(ci, 1); else return; }
    else if (a === "vmas") { const p = c.platos[pi]; p.variantes = p.variantes || (p.precio !== undefined ? [{ etiqueta: "", precio: p.precio }] : []); p.variantes.push({ etiqueta: "", precio: 0 }); delete p.precio; }
    else if (a === "vquitar") { const p = c.platos[pi]; p.precio = p.variantes?.[0]?.precio; delete p.variantes; }
    render();
  });

  document.getElementById("nueva").onclick = () => {
    menu.push({ titulo: "Nueva categoría", pagina: Math.max(1, ...menu.map((c) => Number(c.pagina) || 1)), oculta: false, subtitulo: "", columnas: [], platos: [] });
    render();
    window.scrollTo(0, document.body.scrollHeight);
  };

  document.getElementById("guardar").onclick = async () => {
    const limpio = JSON.parse(JSON.stringify(menu));
    limpio.forEach((c) => c.platos.forEach((p) => { if (p.precio === undefined) delete p.precio; }));
    const r = await fetch("/__guardar-menu", { method: "POST", body: JSON.stringify(limpio) });
    msg.textContent = r.ok ? "✅ Guardado" : "❌ Error al guardar";
    setTimeout(() => (msg.textContent = ""), 3000);
  };

  render();
</script>
